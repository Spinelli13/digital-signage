<?xml version="1.0" encoding="utf-8"?>
<!--
    Vídeo desenhado em TextureView: é o único que acompanha o giro do conteúdo (SurfaceView ignora a rotação da tela
    pai). Só é usado quando a TV está instalada na vertical; o resto continua com o SurfaceView, mais leve.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="invisible"
    app:resize_mode="fit"
    app:shutter_background_color="#000000"
    app:surface_type="texture_view"
    app:use_controller="false" />
