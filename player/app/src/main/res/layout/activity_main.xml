<?xml version="1.0" encoding="utf-8"?>
<!-- Tudo vive dentro do RotatedFrame: com a TV instalada na vertical ele gira o conteúdo (ver RotatedFrame). -->
<com.digitalsignage.player.RotatedFrame xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background">

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:scaleType="fitCenter"
        android:visibility="invisible" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        app:use_controller="false"
        app:resize_mode="fit"
        app:shutter_background_color="#000000" />

    <!-- Zonas de um layout (e o WebView da tela cheia). Transparente e sem nada dentro, não aparece. -->
    <FrameLayout
        android:id="@+id/zonesRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Tarja de erro: aparece por 10 s sobre qualquer coisa que esteja na tela -->
    <TextView
        android:id="@+id/errorBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC8C1D2C"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="40dp"
        android:paddingVertical="22dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/brand_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:id="@+id/brandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/brand_title"
            android:textColor="@color/brand_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/messageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="@color/brand_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- O QR Code (quando o servidor manda o endereço) ao lado do código de 6 letras, que continua valendo para digitar. -->
        <LinearLayout
            android:id="@+id/pairingRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/pairingQr"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginEnd="36dp"
                android:contentDescription="@string/pairing_qr_description"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.25"
                android:textColor="@color/brand_text"
                android:textSize="72sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/messageBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:textColor="@color/brand_muted"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/serverInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:textColor="@color/brand_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Aviso em tela cheia ("Alertar agora"): por cima de tudo, inclusive da tarja de erro. A cor vem da urgência (ver AlertLook). -->
    <LinearLayout
        android:id="@+id/alertOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3261E"
        android:elevation="24dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="56dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/alertTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:textColor="#E6FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/alertMessage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="140sp"
            app:autoSizeMinTextSize="28sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>

</FrameLayout>

</com.digitalsignage.player.RotatedFrame>
