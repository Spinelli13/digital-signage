POSTGRES_USER=signage
POSTGRES_PASSWORD=changeme
POSTGRES_DB=digital_signage

# Chave usada para assinar os tokens JWT do painel administrativo.
# Gerar uma própria antes de qualquer deploy real, nunca reaproveitar este valor.
JWT_SECRET=dev-only-secret-change-me-before-any-real-deploy-0123456789

# Administrador único criado automaticamente na primeira inicialização (MVP = 1 administrador).
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@digitalsignage.local
ADMIN_PASSWORD=changeme
