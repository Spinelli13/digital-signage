POSTGRES_USER=signage
POSTGRES_PASSWORD=changeme
POSTGRES_DB=digital_signage

# Chave usada para assinar os tokens JWT do painel administrativo.
# Gerar uma própria antes de qualquer deploy real, nunca reaproveitar este valor.
JWT_SECRET=dev-only-secret-change-me-before-any-real-deploy-0123456789

# Administrador único criado automaticamente na primeira inicialização (MVP = 1 administrador).
# Atenção: só é criado se ainda não existir; mudar a senha aqui depois NÃO altera um admin já criado.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@digitalsignage.local
ADMIN_PASSWORD=changeme

# Origens do painel web autorizadas a chamar a API (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Onde guardar as mídias: "local" (volume do Docker) ou "s3" (R2, B2, Supabase Storage, MinIO...).
# Hosts gratuitos têm disco efêmero: na nuvem use s3. Detalhes em docs/DEPLOY.md.
STORAGE_TYPE=local
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Na nuvem use true: o backend recusa subir se JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD ou POSTGRES_PASSWORD
# estiverem nos valores padrão deste arquivo. Em desenvolvimento local deixe false.
REQUIRE_STRONG_SECRETS=false
